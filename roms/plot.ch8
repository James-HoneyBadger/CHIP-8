; PLOT -- a graph plotter.
; speed 100
;
; Two curves, axes, and a label. Nothing here computes a function: a 1977
; program that wants a sine carries a table of one, which is `.bytes` and
; sixty-four numbers. That is the lesson of the file -- on a machine with no
; floating point and 3.5 kilobytes of program space, a function is data.
;
; The drawing is the graphics library: `d_line` for the axes, `d_plot` for the
; curve, which is one pixel at a time and therefore exactly what a graph is.

start:  CLS
        ; the axes, crossing in the middle
        LD V0, 0
        LD V1, 16
        LD V2, 63
        LD V3, 16
        CALL d_line
        LD V0, 32
        LD V1, 0
        LD V2, 32
        LD V3, 31
        CALL d_line
        CALL curve_sine
        CALL curve_hill
        LD V0, 2
        LD V1, 1
        .print label
        HALT

; ---------------------------------------------------------------------------
; curve_sine: one pixel per column, from the table.
; ---------------------------------------------------------------------------
curve_sine:
    LD V4, 0                 ; the column
curve_sine_loop:
    LD I, sine
    ADD I, V4
    LD V1, [I]               ; the row this column's sample sits on
    LD V0, V4
    CALL d_plot
    ADD V4, 1
    LD V5, 64
    SUB V5, V4               ; VF = 1 while the column is inside the table
    SE VF, 0
    JP curve_sine_loop
    RET

; ---------------------------------------------------------------------------
; curve_hill: the same loop over a different table, to show that it is the
; table and not the code that draws the shape.
; ---------------------------------------------------------------------------
curve_hill:
    LD V4, 0
curve_hill_loop:
    LD I, hill
    ADD I, V4
    LD V1, [I]
    LD V0, V4
    CALL d_plot
    ADD V4, 1
    LD V5, 64
    SUB V5, V4
    SE VF, 0
    JP curve_hill_loop
    RET

.string label "Y = SIN X"
; A sine through one period, sampled sixty-four times: row 16 is the axis, and
; the numbers run 16, 13, 10 ... 8 ... 24 ... and back to 16. The amplitude is
; eight rather than fifteen so the top of the screen is clear for the label.
.bytes sine
    16,15,14,14,13,12,12,11,10,10,9,9,9,8,8,8
    8,8,8,8,9,9,9,10,10,11,12,12,13,14,14,15
    16,17,18,18,19,20,20,21,22,22,23,23,23,24,24,24
    24,24,24,24,23,23,23,22,22,21,20,20,19,18,18,17
.end
; A hill: a different shape from the same kind of table.
.bytes hill
    21,21,21,22,22,22,23,23,23,24,24,24,25,25,25,26
    26,26,27,27,27,28,28,28,29,29,29,30,30,30,31,31
    31,31,31,30,30,30,29,29,29,28,28,28,27,27,27,26
    26,26,25,25,25,24,24,24,23,23,23,22,22,22,21,21
.end

.include text
.include draw
